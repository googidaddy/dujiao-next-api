# Review and merge into the existing shop server block after a successful rehearsal.
# Keep its TLS, server_name, upload limit, and applicable real-IP rules.
# Remove or update old /api/, /uploads/, sitemap and robots locations that override this location.
location / {
    proxy_pass http://127.0.0.1:48020;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
