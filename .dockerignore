.git
.github
.idea
.vscode
.DS_Store

# 运行时数据，不属于构建上下文
db/
uploads/
logs/
config.yml
*.db
*.log

# 构建产物：前端 dist 由镜像内的 frontend 阶段重新生成，
# internal/web/dist 由 COPY --from=frontend 填充，都不能从宿主机带进来
dist/
frontend/*/dist/
frontend/*/node_modules/
internal/web/dist/

# Exclude deployment state and secrets from every image layer.
.env
.env.*
**/.env
**/.env.*
**/config/config.yml
**/data/
**/backups/
**/*.dump
**/*.dump.part
**/*.rdb
**/*.aof
**/*.pem
**/*.key

# Local handover notes must also stay out of build contexts and build caches.
MAIMEN.md
AGENTS.md
CLAUDE.md
GEMINI.md
HANDOFF.md
handoff*.md
.agents/
.codex/
.claude/
.local/
private/
secrets/
.ssh/
image-digest.txt
image-receipt.json
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.ppk
**/*.crt
**/*.cer
**/id_rsa
**/id_ed25519
**/*.sql.gz
**/*.sql.xz
**/*.sql.zst
**/config.yml
**/config.yaml
**/logs/
**/*.log
**/*.log.*
